# ============================================
# .gitignore - Face Swap Borne
# ============================================

# === Photos générées (ne jamais pousser) ===
output/
*.jpg
*.jpeg
*.png
*.webp

# Sauf les templates et assets (on les garde)
!assets/templates/*.jpg
!assets/templates/*.jpeg
!assets/templates/*.png
!assets/templates/*.webp
!assets/logo.png
!assets/background.jpg

# === Modèles IA (trop lourds pour GitHub) ===
models/
*.onnx
*.pth
*.pt
*.bin

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# === Environnements virtuels ===
venv/
env/
.venv/
.env/

# === IDE ===
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# === OS Windows ===
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# === OS Mac ===
.DS_Store
.AppleDouble
.LSOverride

# === Logs ===
*.log
logs/

# === Fichiers temporaires ===
*.tmp
*.temp
temp/
tmp/
